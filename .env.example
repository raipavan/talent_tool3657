# Production & Self-Hosted CMS Database
# When DATABASE_URL is set, CMS content, users, media, revisions and leads are stored in PostgreSQL.
# When left empty, the server automatically uses local atomic JSON files in ./data/
DATABASE_URL=
# PGSSLMODE=require

# Server & JWT Auth Secret
PORT=4050
CMS_JWT_SECRET=
SITE_URL=https://talent-tool3657.onrender.com

# Optional Initial Super Admin Seed (only used on brand new empty database)
CMS_ADMIN_USER=
CMS_ADMIN_PASSWORD=

# Optional Cookie-Gated Analytics (can also be configured directly in Studio -> SEO & Plugins)
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
VITE_HOTJAR_ID=

# Optional Sanity Cloud Configuration (if dual-mode Sanity is used)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-03-01
